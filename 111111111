    elif method == "bilora_e":
        from methods.bilora_e import BiLoRAe
        return BiLoRAe(args)   
    elif method == 'splitlorav6':
        from methods.splitlorav6 import SplitLoRAV6
        return SplitLoRAV6(args)    
